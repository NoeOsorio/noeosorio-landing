rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is closed unless a rule below opens it.
    match /{document=**} {
      allow read, write: if false;
    }

    // Essay Studio waitlist: anyone can add one email, nobody can read, change or delete.
    match /essay_waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'lang', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]{2,}$')
        && request.resource.data.lang in ['es', 'en']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
